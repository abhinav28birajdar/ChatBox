rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // ─── User avatars & banners ─────────────────────────────────
    match /users/{userId}/{allPaths=**} {
      // Anyone authenticated can view avatars/banners
      allow read: if request.auth != null;
      // Only the owner can upload, with size and type restrictions
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|gif|webp)');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // ─── Server assets (icons, banners, attachments) ────────────
    match /servers/{serverId}/{allPaths=**} {
      allow read: if request.auth != null;
      // Allow authenticated users to upload (member check handled at app level)
      allow write: if request.auth != null
                   && request.resource.size < 25 * 1024 * 1024
                   && (request.resource.contentType.matches('image/(jpeg|png|gif|webp)')
                       || request.resource.contentType.matches('video/(mp4|webm|quicktime)')
                       || request.resource.contentType.matches('audio/(mpeg|wav|ogg)')
                       || request.resource.contentType.matches('application/pdf'));
      allow delete: if request.auth != null;
    }
    
    // ─── Direct message attachments ─────────────────────────────
    match /dms/{chatId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 25 * 1024 * 1024
                   && (request.resource.contentType.matches('image/(jpeg|png|gif|webp)')
                       || request.resource.contentType.matches('video/(mp4|webm|quicktime)')
                       || request.resource.contentType.matches('audio/(mpeg|wav|ogg)')
                       || request.resource.contentType.matches('application/pdf'));
      allow delete: if request.auth != null;
    }

    // ─── Default deny ───────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
